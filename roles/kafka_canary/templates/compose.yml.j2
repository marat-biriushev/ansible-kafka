# {{ ansible_managed }}
name: kafka-canary
services:
  kafka-canary:
    image: "{{ kafka_canary_image }}"
    container_name: kafka-canary
    restart: unless-stopped
    ports:
      - "{{ kafka_canary_port }}:8080"
    env_file:
      - secrets.env
    environment:
      KAFKA_BOOTSTRAP_SERVERS: "{{ kafka_canary_bootstrap_servers | join(',') }}"
      TOPIC: "{{ kafka_canary_topic }}"
      CONSUMER_GROUP_ID: "{{ kafka_canary_group_id }}"
      EXPECTED_CLUSTER_SIZE: "{{ kafka_canary_expected_cluster_size }}"
      SASL_MECHANISM: SCRAM-SHA-512
      SASL_USER: "{{ kafka_canary_kafka_user }}"
      TLS_ENABLED: "true"
      # Go reads trusted CAs from this file
      SSL_CERT_FILE: /etc/kafka-ca/ca.pem
{% for key, value in kafka_canary_env_extra | dictsort %}
      {{ key }}: "{{ value }}"
{% endfor %}
    volumes:
      - "{{ kafka_canary_ca_file }}:/etc/kafka-ca/ca.pem:ro"
    healthcheck:
      test: {{ kafka_canary_healthcheck | to_json }}
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s
