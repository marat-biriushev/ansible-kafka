# {{ ansible_managed }}
# JVM options for kafka.service
KAFKA_HEAP_OPTS="-Xms{{ kafka_heap }} -Xmx{{ kafka_heap }}"
KAFKA_JVM_PERFORMANCE_OPTS="{{ kafka_jvm_performance_opts }}"
KAFKA_LOG4J_OPTS="-Dlog4j2.configurationFile={{ kafka_conf_dir }}/log4j2.yaml"
KAFKA_OPTS="{{ ([('-javaagent:' ~ kafka_jmx_exporter_jar ~ '=' ~ kafka_jmx_exporter_port ~ ':' ~ kafka_jmx_exporter_config) if kafka_jmx_exporter_enabled else ''] + [kafka_opts_extra]) | select | join(' ') }}"
LOG_DIR="{{ kafka_log_dir }}"
