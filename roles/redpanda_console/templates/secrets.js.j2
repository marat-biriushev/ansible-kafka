// {{ ansible_managed }}
// Read by the nginx master (root) at startup; the file is 0600.
export default {
    user: {{ redpanda_console_login_user | to_json }},
    salt: {{ redpanda_console_login_salt | to_json }},
    // sha256(salt + password)
    hash: {{ (redpanda_console_login_salt ~ redpanda_console_login_password) | hash('sha256') | to_json }},
    // HMAC key for the session cookie; changes with the password, which
    // logs everybody out
    key: {{ (redpanda_console_login_salt ~ ':cookie:' ~ redpanda_console_login_password) | hash('sha256') | to_json }},
    ttl: {{ redpanda_console_session_hours * 3600 }}
};
