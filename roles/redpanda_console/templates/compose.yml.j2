# {{ ansible_managed }}
name: redpanda-console
services:
  console:
    image: "{{ redpanda_console_image }}"
    container_name: redpanda-console
    restart: unless-stopped
    env_file:
      - secrets.env
    environment:
      CONFIG_FILEPATH: /etc/redpanda-console/config.yml
    volumes:
      - "{{ redpanda_console_project_dir }}/config.yml:/etc/redpanda-console/config.yml:ro"
      - "{{ redpanda_console_ca_file }}:/etc/kafka-ca/ca.pem:ro"
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/admin/health"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
  nginx:
    image: "{{ redpanda_console_nginx_image }}"
    container_name: redpanda-console-nginx
    restart: unless-stopped
    ports:
      - "{{ redpanda_console_port }}:8080"
    volumes:
      - "{{ redpanda_console_project_dir }}/nginx.conf:/etc/nginx/conf.d/default.conf:ro"
      - "{{ redpanda_console_project_dir }}/htpasswd:/etc/nginx/htpasswd:ro"
    depends_on:
      console:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/nginx-health"]
      interval: 30s
      timeout: 10s
      retries: 5
