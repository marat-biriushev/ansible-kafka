# {{ ansible_managed }}
# nginx in front of Redpanda Console: an HTML login form (auth.js, njs) and
# a signed session cookie. Not HTTP Basic: the bank's browser policy
# (AuthSchemes = Negotiate,NTLM) never shows the Basic password dialog.
load_module modules/ngx_http_js_module.so;

user nginx;
worker_processes 1;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    access_log /dev/stdout;
    client_max_body_size 20m;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;

    js_path /etc/nginx/njs/;
    js_import auth from auth.js;

    # Slows down password guessing: 10 login attempts a minute per address
    limit_req_zone $binary_remote_addr zone=login:1m rate=10r/m;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ""      "";
    }

    server {
        listen 8080;
        # Relative Location headers: the container port (8080) is not the
        # published one (8090)
        absolute_redirect off;

        # Unauthenticated, for the container healthcheck only
        location = /nginx-health {
            access_log off;
            return 200 "ok\n";
        }

        location = /login {
            limit_req zone=login burst=5 nodelay;
            limit_req_status 429;
            js_content auth.login;
        }

        location = /logout {
            js_content auth.logout;
        }

        location = /_auth {
            internal;
            js_content auth.check;
        }

        location @login {
            js_content auth.redirect;
        }

        location / {
            auth_request /_auth;
            error_page 401 = @login;
            proxy_pass http://console:8080;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            # Live message streaming uses websockets / long requests
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 300s;
        }
    }
}
