---
# Copy to vault.yml, fill in, then encrypt:
#   cp vault.yml.example vault.yml && ansible-vault encrypt vault.yml
# Passwords: 12+ characters; none of , [ ] " = $ # \ ` or spaces (they end up
# in SCRAM option strings, JAAS strings and env files).
vault_kafka_admin_password: CHANGE_ME_admin
vault_kafka_tls_keystore_password: CHANGE_ME_keystore
vault_kafka_tls_truststore_password: CHANGE_ME_truststore
vault_kafka_ui_login_password: CHANGE_ME_ui_login

# One SCRAM-SHA-512 account per service; the keys are the account names.
vault_kafka_scram_passwords:
  schema-registry: CHANGE_ME_schema_registry
  kafka-ui: CHANGE_ME_kafka_ui
  kafka-exporter: CHANGE_ME_kafka_exporter
  canary: CHANGE_ME_canary
